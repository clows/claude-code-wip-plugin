{
  "name": "wip",
  "version": "1.0.0",
  "description": "AI-assisted project management workflows",
  "author": {
    "name": "Klaus"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/work_in_project/scripts/hooks/session_start.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/work_in_project/scripts/hooks/stop.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/work_in_project/scripts/hooks/subagent_stop.py"
          }
        ]
      }
    ]
  }
}
